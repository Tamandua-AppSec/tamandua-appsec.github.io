---
import type { Content } from '../i18n/content'
import Note from './Note.astro'
interface Props { t: Content }
const { t } = Astro.props
const k = t.ticket
---
<section id="ticket" class="plate" aria-labelledby="ticket-title" data-held>
  <div class="wrap grid">
    <header class="plate-head">
      <span class="plate-num" aria-hidden="true">{k.number}</span>
      <div>
        <p class="kicker">{k.kicker}</p>
        <h2 id="ticket-title" class="display plate-title" data-split>{k.title}</h2>
      </div>
    </header>
    <p class="lead copy" data-reveal>{k.lead}</p>
    <div class="stage" data-card-stage>
      <Note text={t.notes.ticket} arrow="down-right" place="bottom: calc(100% - 0.5rem); left: -1.5rem" tilt={-5} />
      <!-- Both faces are in the document, front first: the flip is only how it looks. -->
      <article class="card" data-card>
        <div class="face front card-paper">
          <p class="mono card-key">{k.card.key}</p>
          <h3 class="card-title">{k.card.title}</h3>
          <dl>
            {k.card.sections.map(([term, value], index) => (<div><dt class="mono">{term}</dt><dd class:list={[index === 2 && 'mono code']}>{value}</dd></div>))}
          </dl>
        </div>
        <div class="face back card-paper" data-tongue="stop">
          <span class="stamp">{t.ledger.stamp}</span>
          <p>{k.card.back}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .copy { grid-column: 1 / span 5; margin: 0; }
  .stage { grid-column: 7 / span 6; perspective: 1400px; position: relative; }
  .card { position: relative; display: grid; transform-style: preserve-3d; }
  .face {
    grid-area: 1 / 1; padding: clamp(1.25rem, 3vw, 2.25rem); background-color: var(--card); border: 1px solid var(--card-ink); border-radius: 0.5rem;
    backface-visibility: hidden; box-shadow: 0 30px 50px -35px rgb(30 20 51 / 0.5);
  }
  .front { border-top: 6px solid var(--violet); }
  .back { transform: rotateY(180deg); display: grid; place-content: center; justify-items: center; gap: 1.5rem; text-align: center; }
  .back .stamp { font-size: clamp(1.2rem, 1rem + 1vw, 1.8rem); padding: 0.75rem 1.35rem; --ink-at: 210px 25px; }
  .back p { max-width: 24ch; margin: 0; font-family: var(--font-display), serif; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.8rem); line-height: 1.2; }
  .card-key { font-size: 0.8rem; color: var(--violet); margin: 0 0 0.5rem; }
  .card-title { font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem); margin: 0 0 1.25rem; line-height: 1.3; }
  dl { margin: 0; display: grid; gap: 0.9rem; }
  dl > div + div { padding-top: 0.9rem; border-top: 1px dashed var(--rule); }
  dt { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 0.15rem 0 0; }
  .code { font-size: 0.88rem; background: var(--card-ink); color: var(--card); padding: 0.4rem 0.6rem; border-radius: 0.3rem; display: inline-block; }
  /* Without the flip, the back is shown below the front. */
  html.still .card, html.no-js .card { gap: 1.25rem; }
  html.still .back, html.no-js .back { transform: none; grid-area: auto; }
  @media (prefers-reduced-motion: reduce) { .card { gap: 1.25rem; } .back { transform: none; grid-area: auto; } }
  @media (max-width: 64rem) { .copy, .stage { grid-column: 1 / -1; } .stage { margin-top: 2.5rem; } }
</style>
